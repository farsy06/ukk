<div class="row">
    <div class="col-12">
        <%- include('../../_partials/page-head', {
            title: 'Kelola Peminjaman',
            subtitle: 'Pantau semua data peminjaman alat.'
        }) %>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <%- include('../../_partials/table-toolbar', {
            addUrl: '/admin/peminjaman/tambah',
            addLabel: 'Tambah Peminjaman',
            refreshUrl: '/admin/peminjaman',
            searchPlaceholder: 'Cari peminjaman...'
        }) %>

        <div class="card table-card">
            <div class="card-body">
                <table class="table table-striped table-hover table-sm align-middle" id="peminjamanTable">
                        <thead class="table-light">
                            <tr>
                                <th>No</th>
                                <th>Peminjam</th>
                                <th>Alat</th>
                                <th>Periode</th>
                                <th>Status</th>
                                <th>Late/Fine</th>
                                <th class="table-actions">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof peminjaman !== 'undefined' && peminjaman && peminjaman.length > 0) { %>
                                <% peminjaman.forEach(function(item, index) { %>
                                    <% 
                                        const isOverdue = typeof item.isOverdue === 'function' 
                                            ? item.isOverdue() 
                                            : !!item.is_overdue;
                                        const daysOverdue = typeof item.getDaysOverdue === 'function' 
                                            ? item.getDaysOverdue() 
                                            : (item.days_overdue || 0);
                                        const fineAmount = typeof item.calculateFine === 'function' 
                                            ? item.calculateFine() 
                                            : (item.fine_amount || 0);
                                        const paymentStatus = item.status_pembayaran_denda || 'belum_bayar';
                                    %>
                                    <tr data-id="<%= item.id %>" data-peminjam="<%= item.user.nama %>" data-alat="<%= item.alat.nama_alat %>" data-status="<%= item.status %>">
                                        <td><%= (pagination && pagination.offset ? pagination.offset : 0) + index + 1 %></td>
                                        <td class="table-actions">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-info rounded-circle me-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                    <i class="fas fa-user text-white"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold"><%= item.user.nama %></div>
                                                    <small class="text-muted">
                                                        @<%= item.user.username %> | <%= item.user.email %>
                                                    </small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <% if (item.alat.foto) { %>
                                                    <img src="<%= item.alat.foto %>" alt="Foto Alat" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                                <% } else { %>
                                                    <div class="bg-secondary rounded me-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                        <i class="fas fa-box text-white"></i>
                                                    </div>
                                                <% } %>
                                                <div>
                                                    <div class="fw-bold"><%= item.alat.nama_alat %></div>
                                                    <small class="text-muted">
                                                        Kategori: <%= item.alat.kategori ? item.alat.kategori.nama_kategori : 'Tidak ada kategori' %>
                                                    </small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="text-nowrap fw-semibold">
                                                <%= new Date(item.tanggal_pinjam).toLocaleDateString('id-ID') %>
                                                <span class="text-muted">→</span>
                                                <%= new Date(item.tanggal_kembali).toLocaleDateString('id-ID') %>
                                            </div>
                                        </td>
                                        <td>
                                            <% if (item.status === 'pending') { %>
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-clock"></i> Menunggu
                                                </span>
                                            <% } else if (item.status === 'disetujui') { %>
                                                <span class="badge bg-info">
                                                    <i class="fas fa-check-circle"></i> Disetujui
                                                </span>
                                            <% } else if (item.status === 'dipinjam') { %>
                                                <span class="badge bg-primary">
                                                    <i class="fas fa-handshake"></i> Dipinjam
                                                </span>
                                            <% } else if (item.status === 'dikembalikan') { %>
                                                <span class="badge bg-success">
                                                    <i class="fas fa-undo"></i> Kembali
                                                </span>
                                            <% } else if (item.status === 'ditolak') { %>
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times-circle"></i> Ditolak
                                                </span>
                                            <% } %>
                                            <% if (item.tanggal_pengambilan) { %>
                                                <small class="text-muted d-block mt-1">
                                                    Diambil: <%= new Date(item.tanggal_pengambilan).toLocaleDateString('id-ID') %>
                                                </small>
                                            <% } %>
                                            <% if (item.kondisi_pengembalian && item.kondisi_pengembalian !== 'normal') { %>
                                                <small class="d-block mt-1 text-danger">
                                                    <i class="fas fa-triangle-exclamation"></i>
                                                    Kondisi: <%= item.kondisi_pengembalian === 'rusak' ? 'Rusak' : 'Hilang' %>
                                                </small>
                                            <% } %>
                                            <% if (item.foto_pengembalian) { %>
                                                <a href="<%= item.foto_pengembalian %>" target="_blank" class="d-block small mt-1">Lihat foto</a>
                                            <% } %>
                                            <% if (item.tanggal_pengembalian) { %>
                                                <small class="text-muted d-block mt-1">
                                                    Kembali: <%= new Date(item.tanggal_pengembalian).toLocaleDateString('id-ID') %>
                                                </small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (fineAmount > 0) { %>
                                                <% if (daysOverdue > 0) { %>
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-exclamation-triangle"></i> <%= daysOverdue %> hari
                                                    </span>
                                                <% } else if (item.kondisi_pengembalian && item.kondisi_pengembalian !== 'normal') { %>
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="fas fa-triangle-exclamation"></i> Denda Insiden
                                                    </span>
                                                <% } %>
                                                <div class="text-muted small mt-1">
                                                    Rp <%= new Intl.NumberFormat('id-ID').format(fineAmount) %>
                                                </div>
                                                <% if (item.status === 'dikembalikan') { %>
                                                    <div class="mt-1">
                                                        <% if (paymentStatus === 'lunas') { %>
                                                            <span class="badge bg-success">Lunas</span>
                                                        <% } else if (paymentStatus === 'menunggu_verifikasi') { %>
                                                            <span class="badge bg-info">Menunggu Verifikasi</span>
                                                        <% } else if (paymentStatus === 'ditolak') { %>
                                                            <span class="badge bg-danger">Bukti Ditolak</span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning text-dark">Belum Bayar</span>
                                                        <% } %>
                                                    </div>
                                                    <% if (item.bukti_pembayaran) { %>
                                                        <a href="<%= item.bukti_pembayaran %>" target="_blank" class="small d-inline-block mt-1">Lihat bukti</a>
                                                    <% } %>
                                                <% } %>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="dropdown">
                                                <button
                                                    class="btn btn-sm btn-outline-secondary"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                    aria-label="Aksi"
                                                    title="Aksi"
                                                >
                                                    <i class="fas fa-ellipsis-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <% if (['pending', 'ditolak', 'dibatalkan'].includes(item.status)) { %>
                                                        <li>
                                                            <a href="/admin/peminjaman/edit/<%= item.id %>" class="dropdown-item">
                                                                <i class="fas fa-pen-to-square me-2"></i> Edit
                                                            </a>
                                                        </li>
                                                    <% } %>
                                                    <% if (item.status === 'pending') { %>
                                                        <li>
                                                            <form action="/admin/peminjaman/setujui/<%= item.id %>" method="post" class="d-inline">
                                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                                <button type="submit" class="dropdown-item text-success" onclick="return confirm('Setujui peminjaman ini?')">
                                                                    <i class="fas fa-check me-2"></i> Setujui
                                                                </button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form action="/admin/peminjaman/tolak/<%= item.id %>" method="post" class="d-inline">
                                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                                <button type="submit" class="dropdown-item text-danger" onclick="return confirm('Tolak peminjaman ini?')">
                                                                    <i class="fas fa-times me-2"></i> Tolak
                                                                </button>
                                                            </form>
                                                        </li>
                                                    <% } else if (item.status === 'disetujui') { %>
                                                        <li>
                                                            <form action="/admin/peminjaman/ambil/<%= item.id %>" method="post" class="d-inline">
                                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                                <button type="submit" class="dropdown-item text-primary" onclick="return confirm('Konfirmasi pengambilan alat ini?')">
                                                                    <i class="fas fa-handshake me-2"></i> Konfirmasi Ambil
                                                                </button>
                                                            </form>
                                                        </li>
                                                    <% } else if (item.status === 'dipinjam') { %>
                                                        <li>
                                                            <button
                                                                type="button"
                                                                class="dropdown-item text-info open-return-modal"
                                                                data-id="<%= item.id %>"
                                                                data-item-name="<%= item.alat.nama_alat %>"
                                                                data-user-name="<%= item.user.nama %>"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#returnItemModal"
                                                            >
                                                                <i class="fas fa-undo me-2"></i> Kembalikan
                                                            </button>
                                                        </li>
                                                    <% } else if (['pending', 'ditolak', 'dibatalkan'].includes(item.status)) { %>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <form action="/admin/peminjaman/hapus/<%= item.id %>" method="post" class="d-inline">
                                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                                <button type="submit" class="dropdown-item text-danger" onclick="return confirm('Hapus data peminjaman ini?')">
                                                                    <i class="fas fa-trash me-2"></i> Hapus
                                                                </button>
                                                            </form>
                                                        </li>
                                                    <% } else { %>
                                                        <li>
                                                            <span class="dropdown-item text-muted">Tidak ada aksi</span>
                                                        </li>
                                                    <% } %>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="alert alert-info mb-0">
                                            <i class="fas fa-info-circle"></i> Belum ada data peminjaman.
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
            </div>
                <% if (range) { %>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <small class="text-muted">
                            Menampilkan <%= range.start %>-<%= range.end %> dari <%= range.total %> peminjaman
                        </small>
                    </div>
                <% } %>
        </div>

        <% if (pagination && pagination.totalPages > 1) { %>
            <nav class="mt-3" aria-label="Peminjaman pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item <%= pagination.hasPrevious ? '' : 'disabled' %>">
                        <a class="page-link" href="?page=<%= pagination.previousPage %>&limit=<%= pagination.perPage %>">Sebelumnya</a>
                    </li>
                    <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                        <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                            <a class="page-link" href="?page=<%= p %>&limit=<%= pagination.perPage %>"><%= p %></a>
                        </li>
                    <% } %>
                    <li class="page-item <%= pagination.hasNext ? '' : 'disabled' %>">
                        <a class="page-link" href="?page=<%= pagination.nextPage %>&limit=<%= pagination.perPage %>">Berikutnya</a>
                    </li>
                </ul>
            </nav>
        <% } %>
    </div>
</div>

<div class="modal fade" id="returnItemModal" tabindex="-1" aria-labelledby="returnItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="returnItemForm" method="post" action="#" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="modal-header">
                    <h5 class="modal-title" id="returnItemModalLabel">Konfirmasi Pengembalian</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">
                        Alat <strong id="returnItemName">-</strong> oleh <strong id="returnUserName">-</strong>.
                    </p>
                    <div class="mb-3">
                        <label for="kondisi_pengembalian" class="form-label">Kondisi</label>
                        <select class="form-select" name="kondisi_pengembalian" id="kondisi_pengembalian">
                            <option value="normal">Normal</option>
                            <option value="rusak">Rusak</option>
                            <option value="hilang">Hilang</option>
                        </select>
                    </div>
                    <div id="incidentFields" class="d-none">
                        <div class="mb-3">
                            <label for="biaya_insiden" class="form-label">Biaya Insiden (Rp)</label>
                            <input type="number" min="0" step="1000" class="form-control" name="biaya_insiden" id="biaya_insiden" placeholder="0">
                        </div>
                        <div>
                            <label for="catatan_insiden" class="form-label">Catatan Insiden</label>
                            <textarea class="form-control" name="catatan_insiden" id="catatan_insiden" rows="3" placeholder="Jelaskan kerusakan/kehilangan"></textarea>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label for="foto_pengembalian" class="form-label">Foto Kondisi (opsional)</label>
                        <input type="file" class="form-control" name="foto_pengembalian" id="foto_pengembalian" accept="image/jpeg,image/png,image/webp">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-info">Konfirmasi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const clearSearch = document.getElementById('clearSearch');
        const table = document.getElementById('peminjamanTable');
        const rows = table.querySelectorAll('tbody tr');
        const returnItemForm = document.getElementById('returnItemForm');
        const returnItemName = document.getElementById('returnItemName');
        const returnUserName = document.getElementById('returnUserName');
        const returnCondition = document.getElementById('kondisi_pengembalian');
        const incidentFields = document.getElementById('incidentFields');
        const incidentNotes = document.getElementById('catatan_insiden');
        const incidentCost = document.getElementById('biaya_insiden');

        // Search functionality
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase().trim();
                
                rows.forEach(row => {
                    const peminjam = row.getAttribute('data-peminjam').toLowerCase();
                    const alat = row.getAttribute('data-alat').toLowerCase();
                    const status = row.getAttribute('data-status').toLowerCase();
                    
                    const matches = peminjam.includes(searchTerm) || 
                        alat.includes(searchTerm) || 
                        status.includes(searchTerm);
                    
                    row.style.display = matches ? '' : 'none';
                });
            });
        }

        // Clear search functionality
        if (clearSearch) {
            clearSearch.addEventListener('click', function() {
                searchInput.value = '';
                searchInput.dispatchEvent(new Event('input'));
            });
        }

        // Add keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && searchInput.value) {
                searchInput.value = '';
                searchInput.dispatchEvent(new Event('input'));
            }
        });

        const returnTriggers = document.querySelectorAll('.open-return-modal');
        returnTriggers.forEach(button => {
            button.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const itemName = this.getAttribute('data-item-name') || '-';
                const userName = this.getAttribute('data-user-name') || '-';
                if (returnItemForm) returnItemForm.setAttribute('action', `/admin/peminjaman/kembalikan/${id}`);
                if (returnItemName) returnItemName.textContent = itemName;
                if (returnUserName) returnUserName.textContent = userName;
                if (returnCondition) returnCondition.value = 'normal';
                if (incidentFields) incidentFields.classList.add('d-none');
                if (incidentNotes) {
                    incidentNotes.value = '';
                    incidentNotes.required = false;
                }
                if (incidentCost) incidentCost.value = '';
            });
        });

        if (returnCondition) {
            returnCondition.addEventListener('change', function() {
                const isIncident = this.value !== 'normal';
                if (incidentFields) incidentFields.classList.toggle('d-none', !isIncident);
                if (incidentNotes) incidentNotes.required = isIncident;
            });
        }

    });
</script>
